      ]
    },
    {
      "name": "04 - Student APIs (student access JWT)",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{studentAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Submit assignment - save studentAssignmentId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/student/submitassignment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math HW 1\",\n  \"content\": \"Solve linear equations\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('envelope: code=201, no pagination on single-item', () => {",
                  "  pm.expect(json.code).to.eql('201');",
                  "  pm.expect(json.pagination).to.be.undefined;",
                  "});",
                  "pm.test('data persisted by caller email', () => pm.expect(json.data.studentEmail).to.eql(pm.collectionVariables.get('studentEmail')));",
                  "pm.test('data.status=SUBMITTED', () => pm.expect(json.data.status).to.eql('SUBMITTED'));",
                  "pm.collectionVariables.set('studentAssignmentId', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "View my assignments (list with pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/student/viewassignment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('envelope: code=200, data is array, pagination present', () => {",
                  "  pm.expect(json.code).to.eql('200');",
                  "  pm.expect(json.data).to.be.an('array').and.not.be.empty;",
                  "  pm.expect(json.pagination).to.be.an('object');",
                  "});",
                  "pm.test('pagination shape: page/size/total_counts/total_pages', () => {",
                  "  pm.expect(json.pagination.page).to.eql(1);",
                  "  pm.expect(json.pagination.size).to.eql(json.data.length);",
                  "  pm.expect(json.pagination.total_counts).to.eql(json.data.length);",
                  "  pm.expect(json.pagination.total_pages).to.eql(1);",
                  "});",
                  "pm.test('latest belongs to caller', () => pm.expect(json.data[0].studentEmail).to.eql(pm.collectionVariables.get('studentEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update latest assignment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/student/studentupdateprofile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math HW 1 (updated)\",\n  \"content\": \"Solve linear equations - revised\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('title patched', () => pm.expect(json.data.title).to.eql('Math HW 1 (updated)'));",
                  "pm.test('status unchanged on update', () => pm.expect(json.data.status).to.eql('SUBMITTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resubmit latest assignment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/student/studentresubmitassignment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math HW 1 (resubmitted)\",\n  \"content\": \"Final answer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('data.status=RESUBMITTED', () => pm.expect(pm.response.json().data.status).to.eql('RESUBMITTED'));"
                ]
              }
            }
          ]
        }
      ]
    },
