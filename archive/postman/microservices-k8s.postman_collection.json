                  "pm.collectionVariables.set('teacherAccessToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh with access token (wrong typ) - 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{studentAccessToken}}\"\n}"
            }
