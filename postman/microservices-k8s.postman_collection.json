{
  "info": {
    "name": "AUPP Local-First Kubernetes Microservices",
    "_postman_id": "1f8a8b21-4051-42e1-b44d-cab5c23fbd0d",
    "description": "JWT, role-based gateway, teacher tasks, student submissions, MongoDB activity, and forbidden cross-role checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "studentJwt",
      "value": ""
    },
    {
      "key": "teacherJwt",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "dueDate",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const due = new Date();",
          "due.setDate(due.getDate() + 7);",
          "pm.collectionVariables.set('dueDate', due.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"student1@aupp.edu\",\"password\":\"student123\",\"role\":\"STUDENT\",\"fullName\":\"Student One\"}"
        },
        "url": "{{gateway}}/auth/register"
      }
    },
    {
      "name": "2. Register Teacher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"teacher1@aupp.edu\",\"password\":\"teacher123\",\"role\":\"TEACHER\",\"fullName\":\"Teacher One\"}"
        },
        "url": "{{gateway}}/auth/register"
      }
    },
    {
      "name": "3. Login Student - Save JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('student login success', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('studentJwt', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"student1@aupp.edu\",\"password\":\"student123\"}"
        },
        "url": "{{gateway}}/auth/login"
      }
    },
    {
      "name": "4. Login Teacher - Save JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('teacher login success', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('teacherJwt', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"teacher1@aupp.edu\",\"password\":\"teacher123\"}"
        },
        "url": "{{gateway}}/auth/login"
      }
    },
    {
      "name": "5. Teacher Creates Task - MongoDB Write",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('teacher creates task', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('taskId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacherJwt}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Kubernetes Local Deployment\",\"description\":\"Deploy all Spring Boot microservices into local Kubernetes and capture screenshots.\",\"course\":\"Cloud Computing\",\"dueDate\":\"{{dueDate}}\",\"maxScore\":100}"
        },
        "url": "{{gateway}}/teacher"
      }
    },
    {
      "name": "6. Teacher Reads Tasks - MongoDB Read",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacherJwt}}"
          }
        ],
        "url": "{{gateway}}/teacher"
      }
    },
    {
      "name": "7. Student Reads Teacher Tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentJwt}}"
          }
        ],
        "url": "{{gateway}}/student/tasks"
      }
    },
    {
      "name": "8. Student Submits Task - MongoDB Write",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentJwt}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"taskId\":\"{{taskId}}\",\"answer\":\"Local Kubernetes deployment is working with MongoDB and JWT authorization.\"}"
        },
        "url": "{{gateway}}/student"
      }
    },
    {
      "name": "9. Student Reads Submissions - MongoDB Read",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentJwt}}"
          }
        ],
        "url": "{{gateway}}/student"
      }
    },
    {
      "name": "10. Teacher JWT Cannot Access Student API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('teacher blocked from student API', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacherJwt}}"
          }
        ],
        "url": "{{gateway}}/student"
      }
    },
    {
      "name": "11. Student JWT Cannot Access Teacher API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('student blocked from teacher API', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentJwt}}"
          }
        ],
        "url": "{{gateway}}/teacher"
      }
    }
  ]
}
