    {
      "name": "03 - Refresh",
      "item": [
        {
          "name": "Refresh student access token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{studentRefreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const oldAccess = pm.collectionVariables.get('studentAccessToken');",
                  "pm.test('new access token returned in data', () => {",
                  "  pm.expect(json.data.accessToken).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(json.data.accessToken).to.not.eql(oldAccess);",
                  "});",
                  "pm.test('refresh token reused', () => pm.expect(json.data.refreshToken).to.eql(pm.collectionVariables.get('studentRefreshToken')));",
                  "pm.test('data.role=student', () => pm.expect(json.data.role).to.eql('student'));",
                  "pm.collectionVariables.set('studentAccessToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
