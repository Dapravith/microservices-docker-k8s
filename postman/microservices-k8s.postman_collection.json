{
  "info": {
    "name": "microservices-k8s (Spring Boot, 5 services)",
    "description": "End-to-end flow against the API Gateway: register → login → role-scoped API calls. Covers every assignment screenshot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register a student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}/register/student",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@itc.edu.kh\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 or 409', () => pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Register a teacher",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}/register/teacher",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ms.smith@itc.edu.kh\",\n  \"password\": \"secret123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 or 409', () => pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login as student → save studentToken",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@itc.edu.kh\",\n  \"password\": \"secret123\",\n  \"role\": \"student\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('studentToken', json.token);",
              "pm.test('token returned', () => pm.expect(json.token).to.be.a('string').and.not.be.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login as teacher → save teacherToken",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gatewayUrl}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ms.smith@itc.edu.kh\",\n  \"password\": \"secret123\",\n  \"role\": \"teacher\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('teacherToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. /student with student JWT → 201 (DB write)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{gatewayUrl}}/student/submitassignment",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Math HW 1\",\n  \"content\": \"Solve linear equations\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('persisted by caller email', () => pm.expect(pm.response.json().studentEmail).to.eql('alice@itc.edu.kh'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. /student with student JWT → 200 (DB read)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{gatewayUrl}}/student/viewassignment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('count >= 1', () => pm.expect(pm.response.json().count).to.be.greaterThan(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. /teacher with teacher JWT → 201 (DB write)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{teacherToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{gatewayUrl}}/teacher/addassignment",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Algebra exam\",\n  \"description\": \"Chapters 1-3\",\n  \"dueDate\": \"2026-12-31T23:59:00Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('persisted by caller email', () => pm.expect(pm.response.json().teacherEmail).to.eql('ms.smith@itc.edu.kh'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. /student with TEACHER JWT → 403 (will not work)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
        "url": "{{gatewayUrl}}/student/viewassignment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
              "pm.test('error explains role mismatch', () => pm.expect(pm.response.text()).to.match(/student/i));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. /teacher with STUDENT JWT → 403 (will not work)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{gatewayUrl}}/teacher/searchstudent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
              "pm.test('error explains role mismatch', () => pm.expect(pm.response.text()).to.match(/teacher/i));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:4000",
      "description": "Use http://localhost:4000 for docker-compose, or http://<EC2-1 public IP>:30000 for the K8s deployment."
    },
    { "key": "studentToken", "value": "" },
    { "key": "teacherToken", "value": "" }
  ]
}
