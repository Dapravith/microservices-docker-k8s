{
  "info": {
    "name": "microservices-k8s (Spring Boot, 5 services)",
    "version": "3.0.0",
    "description": "Full end-to-end coverage against the API Gateway. Run requests in folder order — tokens and IDs are saved into collection variables automatically.\n\n**Folders**\n1. Registration — generic + role-scoped\n2. Login — student + teacher (saves studentToken, teacherToken)\n3. Student APIs — submit / view / update / resubmit\n4. Teacher APIs — add / search / remove (saves teacherAssignmentId, then deletes it)\n5. Negative — RBAC + missing-token rejections\n\n**Setup**\n- `gatewayUrl` defaults to `http://localhost:4000` (docker-compose). For K8s set it to `http://<EC2-1>:30000`.\n- Edit `studentEmail` / `teacherEmail` in collection variables to use different test users; the password rules require ≥ 8 chars with at least one letter and one digit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Registration",
      "item": [
        {
          "name": "Register student (role-scoped)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/register/student",
              "host": ["{{gatewayUrl}}"],
              "path": ["register", "student"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 Conflict (already registered)', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('echoes role=student', () => pm.expect(json.role).to.eql('student'));",
                  "  pm.test('echoes the email', () => pm.expect(json.email).to.eql(pm.collectionVariables.get('studentEmail')));",
                  "  pm.test('returns id and createdAt', () => {",
                  "    pm.expect(json.id).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(json.createdAt).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register teacher (role-scoped)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/register/teacher",
              "host": ["{{gatewayUrl}}"],
              "path": ["register", "teacher"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 Conflict (already registered)', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('echoes role=teacher', () => pm.expect(json.role).to.eql('teacher'));",
                  "  pm.test('echoes the email', () => pm.expect(json.email).to.eql(pm.collectionVariables.get('teacherEmail')));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (generic, role in body)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/register",
              "host": ["{{gatewayUrl}}"],
              "path": ["register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{thirdEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 Conflict (already registered)', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('role from body is honored', () => pm.expect(json.role).to.eql('student'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register validation error → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/register/student",
              "host": ["{{gatewayUrl}}"],
              "path": ["register", "student"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Login",
      "item": [
        {
          "name": "Login as student → save studentToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Bearer token returned', () => {",
                  "  pm.expect(json.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(json.tokenType).to.eql('Bearer');",
                  "  pm.expect(json.role).to.eql('student');",
                  "  pm.expect(json.expiresInSeconds).to.be.a('number').and.be.greaterThan(0);",
                  "});",
                  "pm.collectionVariables.set('studentToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as teacher → save teacherToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\",\n  \"role\": \"teacher\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Bearer token returned', () => {",
                  "  pm.expect(json.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(json.role).to.eql('teacher');",
                  "});",
                  "pm.collectionVariables.set('teacherToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"wrong-password-1\",\n  \"role\": \"student\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Student APIs (student JWT)",
      "item": [
        {
          "name": "Submit assignment → save studentAssignmentId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/student/submitassignment",
              "host": ["{{gatewayUrl}}"],
              "path": ["student", "submitassignment"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math HW 1\",\n  \"content\": \"Solve linear equations\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('persisted by caller email', () => pm.expect(json.studentEmail).to.eql(pm.collectionVariables.get('studentEmail')));",
                  "pm.test('status = SUBMITTED', () => pm.expect(json.status).to.eql('SUBMITTED'));",
                  "pm.test('echoes title and content', () => {",
                  "  pm.expect(json.title).to.eql('Math HW 1');",
                  "  pm.expect(json.content).to.eql('Solve linear equations');",
                  "});",
                  "pm.test('createdAt and updatedAt set', () => {",
                  "  pm.expect(json.createdAt).to.be.a('string');",
                  "  pm.expect(json.updatedAt).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('studentAssignmentId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "View my assignments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/student/viewassignment",
              "host": ["{{gatewayUrl}}"],
              "path": ["student", "viewassignment"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('count >= 1 and matches list length', () => {",
                  "  pm.expect(json.count).to.be.greaterThan(0);",
                  "  pm.expect(json.assignments).to.be.an('array').with.lengthOf(json.count);",
                  "});",
                  "pm.test('latest belongs to caller', () => pm.expect(json.assignments[0].studentEmail).to.eql(pm.collectionVariables.get('studentEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update latest assignment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/student/studentupdateprofile",
              "host": ["{{gatewayUrl}}"],
              "path": ["student", "studentupdateprofile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math HW 1 (updated)\",\n  \"content\": \"Solve linear equations — revised\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('title was patched', () => pm.expect(json.title).to.eql('Math HW 1 (updated)'));",
                  "pm.test('content was patched', () => pm.expect(json.content).to.eql('Solve linear equations — revised'));",
                  "pm.test('status unchanged on update', () => pm.expect(json.status).to.eql('SUBMITTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resubmit latest assignment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/student/studentresubmitassignment",
              "host": ["{{gatewayUrl}}"],
              "path": ["student", "studentresubmitassignment"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Math HW 1 (resubmitted)\",\n  \"content\": \"Final answer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status flipped to RESUBMITTED', () => pm.expect(json.status).to.eql('RESUBMITTED'));",
                  "pm.test('content was patched', () => pm.expect(json.content).to.eql('Final answer'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Teacher APIs (teacher JWT)",
      "item": [
        {
          "name": "Add assignment → save teacherAssignmentId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/addassignment",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "addassignment"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Algebra exam\",\n  \"description\": \"Chapters 1-3\",\n  \"dueDate\": \"2026-12-31T23:59:00Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('persisted by caller email', () => pm.expect(json.teacherEmail).to.eql(pm.collectionVariables.get('teacherEmail')));",
                  "pm.test('echoes title, description, dueDate', () => {",
                  "  pm.expect(json.title).to.eql('Algebra exam');",
                  "  pm.expect(json.description).to.eql('Chapters 1-3');",
                  "  pm.expect(json.dueDate).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('teacherAssignmentId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search assignments by title",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/searchstudent?title=Algebra",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "searchstudent"],
              "query": [{ "key": "title", "value": "Algebra" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('count >= 1', () => pm.expect(json.count).to.be.greaterThan(0));",
                  "pm.test('every result matches title filter', () => json.assignments.forEach(a => pm.expect(a.title).to.match(/Algebra/i)));",
                  "pm.test('every result belongs to caller', () => json.assignments.forEach(a => pm.expect(a.teacherEmail).to.eql(pm.collectionVariables.get('teacherEmail'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search assignments (no filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/searchstudent",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "searchstudent"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('count matches list length', () => pm.expect(json.assignments).to.have.lengthOf(json.count));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove assignment by id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/removeassignment/{{teacherAssignmentId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "removeassignment", "{{teacherAssignmentId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('confirms removed id', () => pm.expect(json.id).to.eql(pm.collectionVariables.get('teacherAssignmentId')));",
                  "pm.test('returns success message', () => pm.expect(json.message).to.match(/removed/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove unknown id → 404",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/removeassignment/000000000000000000000000",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "removeassignment", "000000000000000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Negative (RBAC + auth)",
      "item": [
        {
          "name": "/student with TEACHER JWT → 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/student/viewassignment",
              "host": ["{{gatewayUrl}}"],
              "path": ["student", "viewassignment"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('error message names the required role', () => pm.expect(pm.response.text()).to.match(/role=student/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "/teacher with STUDENT JWT → 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/searchstudent",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "searchstudent"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('error message names the required role', () => pm.expect(pm.response.text()).to.match(/role=teacher/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "/student with NO token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/student/viewassignment",
              "host": ["{{gatewayUrl}}"],
              "path": ["student", "viewassignment"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('mentions missing Bearer', () => pm.expect(pm.response.text()).to.match(/bearer/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "/teacher with INVALID token → 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-real-jwt" }],
            "url": {
              "raw": "{{gatewayUrl}}/teacher/searchstudent",
              "host": ["{{gatewayUrl}}"],
              "path": ["teacher", "searchstudent"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:4000",
      "description": "Use http://localhost:4000 for docker-compose, or http://<EC2-1 public IP>:30000 for the K8s deployment."
    },
    { "key": "studentEmail", "value": "alice@itc.edu.kh" },
    { "key": "teacherEmail", "value": "ms.smith@itc.edu.kh" },
    { "key": "thirdEmail", "value": "carol@itc.edu.kh", "description": "Used by the generic POST /register call so it does not collide with the role-scoped registrations." },
    { "key": "studentPassword", "value": "secret123", "description": "Must be 8-100 chars, contain ≥ 1 letter and ≥ 1 digit." },
    { "key": "teacherPassword", "value": "secret123" },
    { "key": "studentToken", "value": "" },
    { "key": "teacherToken", "value": "" },
    { "key": "studentAssignmentId", "value": "" },
    { "key": "teacherAssignmentId", "value": "" }
  ]
}
