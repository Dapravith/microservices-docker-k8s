{
  "info": {
    "name": "AUPP Microservices (Docker + K8s)",
    "_postman_id": "8e9b6e3a-aupp-2026-mskap-collection-01",
    "description": "End-to-end demo of JWT login + role-based authorization across the api-gateway. Set the collection variable `gateway` to your gateway URL (e.g. http://<EC2-public-IP>:30080 in AWS, or http://localhost:8080 locally).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway",     "value": "http://localhost:8080" },
    { "key": "studentJwt",  "value": "" },
    { "key": "teacherJwt",  "value": "" }
  ],
  "item": [
    {
      "name": "1. Register student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{gateway}}/auth/register", "host": ["{{gateway}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student1@aupp.edu\",\n  \"password\": \"Student#123\",\n  \"role\": \"STUDENT\",\n  \"fullName\": \"Sothea Student\"\n}"
        }
      }
    },
    {
      "name": "2. Register teacher",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{gateway}}/auth/register", "host": ["{{gateway}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teacher1@aupp.edu\",\n  \"password\": \"Teacher#123\",\n  \"role\": \"TEACHER\",\n  \"fullName\": \"Dara Teacher\"\n}"
        }
      }
    },
    {
      "name": "3. Login as student (saves studentJwt)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has token', () => pm.expect(json.token).to.be.a('string').and.have.length.greaterThan(20));",
              "pm.collectionVariables.set('studentJwt', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{gateway}}/auth/login", "host": ["{{gateway}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student1@aupp.edu\",\n  \"password\": \"Student#123\"\n}"
        }
      }
    },
    {
      "name": "4. Login as teacher (saves teacherJwt)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has token', () => pm.expect(json.token).to.be.a('string').and.have.length.greaterThan(20));",
              "pm.collectionVariables.set('teacherJwt', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{gateway}}/auth/login", "host": ["{{gateway}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teacher1@aupp.edu\",\n  \"password\": \"Teacher#123\"\n}"
        }
      }
    },
    {
      "name": "5. GET /student/me with student JWT  (expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentJwt}}" }],
        "url": { "raw": "{{gateway}}/student/me", "host": ["{{gateway}}"], "path": ["student", "me"] }
      }
    },
    {
      "name": "6. GET /teacher/me with teacher JWT  (expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teacherJwt}}" }],
        "url": { "raw": "{{gateway}}/teacher/me", "host": ["{{gateway}}"], "path": ["teacher", "me"] }
      }
    },
    {
      "name": "7. POST /student with student JWT (DB write)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentJwt}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "url": { "raw": "{{gateway}}/student", "host": ["{{gateway}}"], "path": ["student"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sothea\",\n  \"major\": \"Computer Science\",\n  \"year\": 3,\n  \"gpa\": 3.7\n}"
        }
      }
    },
    {
      "name": "8. POST /teacher with teacher JWT (DB write)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{teacherJwt}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "url": { "raw": "{{gateway}}/teacher", "host": ["{{gateway}}"], "path": ["teacher"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Dara\",\n  \"department\": \"Computer Science\",\n  \"courses\": [\"Distributed Systems\", \"Cloud Computing\"],\n  \"yearsOfExperience\": 12\n}"
        }
      }
    },
    {
      "name": "9. GET /student/me with TEACHER JWT  (expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teacherJwt}}" }],
        "url": { "raw": "{{gateway}}/student/me", "host": ["{{gateway}}"], "path": ["student", "me"] }
      }
    },
    {
      "name": "10. GET /teacher/me with STUDENT JWT  (expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentJwt}}" }],
        "url": { "raw": "{{gateway}}/teacher/me", "host": ["{{gateway}}"], "path": ["teacher", "me"] }
      }
    },
    {
      "name": "11. GET /student/me with NO JWT  (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{gateway}}/student/me", "host": ["{{gateway}}"], "path": ["student", "me"] }
      }
    }
  ]
}
