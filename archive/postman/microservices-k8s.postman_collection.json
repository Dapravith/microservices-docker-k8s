    {
      "name": "02 - Login",
      "item": [
        {
          "name": "Login as student - save access + refresh tokens",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('envelope: code=200, message=OK, no pagination', () => {",
                  "  pm.expect(json.code).to.eql('200');",
                  "  pm.expect(json.message).to.eql('OK');",
                  "  pm.expect(json.pagination).to.be.undefined;",
                  "});",
                  "pm.test('data has access + refresh tokens', () => {",
                  "  pm.expect(json.data.accessToken).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(json.data.refreshToken).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(json.data.accessToken).to.not.eql(json.data.refreshToken);",
                  "});",
                  "pm.test('data.tokenType=Bearer, role=student', () => {",
                  "  pm.expect(json.data.tokenType).to.eql('Bearer');",
                  "  pm.expect(json.data.role).to.eql('student');",
                  "});",
                  "pm.test('refresh expiry > access expiry', () => pm.expect(json.data.refreshExpiresInSeconds).to.be.greaterThan(json.data.accessExpiresInSeconds));",
                  "pm.collectionVariables.set('studentAccessToken', json.data.accessToken);",
                  "pm.collectionVariables.set('studentRefreshToken', json.data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as teacher - save access + refresh tokens",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\",\n  \"role\": \"teacher\"\n}"
            }
