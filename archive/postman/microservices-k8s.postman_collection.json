              "mode": "raw",
              "raw": "{\n  \"email\": \"{{thirdEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 Conflict', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "  pm.test('role from body is honored', () => pm.expect(json.data.role).to.eql('student'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register validation error - 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gatewayUrl}}/register/student",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('envelope code = 400 and data null', () => {",
                  "  pm.expect(json.code).to.eql('400');",
                  "  pm.expect(json.data).to.be.undefined;",
                  "});",
                  "pm.test('message describes the failure', () => pm.expect(json.message).to.match(/validation|email|password/i));"
                ]
              }
            }
